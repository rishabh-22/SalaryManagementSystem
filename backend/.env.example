# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Chat assistant provider. true -> Anthropic (Claude); anything else (default) -> OpenAI.
USE_ANTHROPIC_KEY=false

# Used when USE_ANTHROPIC_KEY=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Used when USE_ANTHROPIC_KEY=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# If the selected provider's key is empty, POST /api/chat returns 503 and the rest of the app works.

# Optional overrides
# JWT_SECRET=change-me
# DATABASE_URL=sqlite:///./salary.db
