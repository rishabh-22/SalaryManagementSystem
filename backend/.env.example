# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Chat assistant provider: openai, anthropic or gemini. Empty disables the chat.
# Any other value stops the app at startup.
AGENT_PROVIDER=

# Used when AGENT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Used when AGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Used when AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# If AGENT_PROVIDER is empty or the selected provider's key is empty, POST /api/chat returns 503
# and the rest of the app works.

# Optional overrides
# JWT_SECRET=change-me
# DATABASE_URL=sqlite:///./salary.db
